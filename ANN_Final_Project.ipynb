        "print(df_long.groupby(\"SegmentID\").size().sort_values(ascending=False).head(10))\n",
        "\n",
        "print(\"\\nDatetime range:\")\n",
        "print(df_long[\"Datetime\"].min(), \"→\", df_long[\"Datetime\"].max())\n",
        "df_long.head()"
      ],
